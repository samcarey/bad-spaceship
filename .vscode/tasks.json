{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run (release)",
            "type": "shell",
            "command": "cargo make run --profile release",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build (debug)",
            "type": "shell",
            "command": "cargo make build-native"
        },
    ]
}