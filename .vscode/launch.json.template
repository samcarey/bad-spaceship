  "version": "0.2.0",
  "configurations": [
    {
      "name": "debug-windows",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/client/target/debug/bad-spaceship-client",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceRoot}",
      "console": "externalTerminal",
      "preLaunchTask": "build-native-debug",
      "env": {
        "CARGO_MANIFEST_DIR": "${workspaceFolder}/client"
      },
    },
    {
      "name": "debug-server-windows",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/server/target/debug/bad-spaceship-server",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceRoot}",
      "console": "externalTerminal",
      "preLaunchTask": "build-server-debug",
      "env": {
        "CARGO_MANIFEST_DIR": "${workspaceFolder}/server"
      },
    },
